# OpenAI 兼容接口配置（DeepSeek / Qwen / OpenAI / vLLM 等均可）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 数据目录（留空则使用默认 app/data/raw）
LOG_LEVEL=INFO

# LangSmith 可观测性（可选，用于追踪 Agent 每次工具调用/LLM 调用链）
# 在 https://smith.langchain.com 注册后获取 API Key，两项同时填写才启用追踪
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxx
LANGSMITH_PROJECT=langchain-data-agent
